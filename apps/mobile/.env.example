# Copy to .env.local (gitignored). EXPO_PUBLIC_* values are inlined into the
# JS bundle at build time — never put secrets here.

# Clerk publishable key (same instance as the web app). Leave unset to run
# in dev mode as the seeded demo user (needs a local API with dev mode on).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# API origin. Unset in dev = your computer's LAN address on :8000 (works on
# a physical phone running Expo Go); unset in release builds = production.
EXPO_PUBLIC_API_URL=
