# Copy to apps/api/.env (gitignored) and fill in as you create accounts.
# Everything runs locally with ALL of these empty (mock/scripted/dev modes).

# --- AI (makes the agent run on Claude instead of the scripted stand-in) ---
KARENBOT_ANTHROPIC_API_KEY=
KARENBOT_LLM_PROVIDER=scripted            # set to "anthropic" once key is in

# --- Email providers (M4 real-account round-trip) -------------------------
KARENBOT_GOOGLE_CLIENT_ID=
KARENBOT_GOOGLE_CLIENT_SECRET=
KARENBOT_MICROSOFT_CLIENT_ID=
KARENBOT_MICROSOFT_CLIENT_SECRET=
KARENBOT_OAUTH_REDIRECT_BASE=http://localhost:8000
KARENBOT_EMAIL_PROVIDER=mock              # per-account providers resolve automatically

# --- Plaid (recurring-bill discovery) --------------------------------------
KARENBOT_PLAID_ENV=mock                   # mock | sandbox | production
KARENBOT_PLAID_CLIENT_ID=
KARENBOT_PLAID_SECRET=

# --- Security / ops ---------------------------------------------------------
# Generate with: python -m karenbot.security.crypto   (REQUIRED outside dev)
KARENBOT_TOKEN_ENCRYPTION_KEY=
KARENBOT_ADMIN_TOKEN=dev-admin            # change for any shared environment
KARENBOT_DEV_MODE=true                    # MUST be false in production
KARENBOT_SENTRY_DSN=

# --- Database ---------------------------------------------------------------
KARENBOT_DATABASE_URL=postgresql+psycopg://karenbot:karenbot@localhost:5432/karenbot
